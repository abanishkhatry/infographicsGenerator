# macOS
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Generated outputs (reproducible from data/ via src/ scripts)
**/output/

# Data files — keep patient/source data out of git (PHI-sensitive)
**/data/*.csv
**/data/**/*.csv
**/data/*.xlsx
**/data/**/*.xlsx
# ...except the analyte reference mapping, which carries no patient data
!new_infogenerator/data/Analyte_Category_Mapping.xlsx

# Versioned data snapshots — versions live locally, out of git. They are derived
# and reproducible from data/ via src/, and the CSVs are PHI-sensitive.
# Everything here is ignored except the README documenting the convention.
new_infogenerator/versioned/*
!new_infogenerator/versioned/README.md

# NOTE: new_infogenerator/sample_images/ is intentionally NOT ignored. It holds
# published reference one-pagers used as design targets. They carry aggregate
# figures only — no patient-level data — so they belong in the repo.
